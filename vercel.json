{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    {
      "src": "/gtimg/(.*)",
      "dest": "http://qt.gtimg.cn/$1"
    },
    {
      "src": "/eastmoney_report/(.*)",
      "dest": "https://reportapi.eastmoney.com/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "https://sqlite-mreb.onrender.com/api/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
